diff --git a/Runtime/Motion/RecordingSourceIdentity.cs b/Runtime/Motion/RecordingSourceIdentity.cs
new file mode 100644
index 0000000000000000000000000000000000000000..72d8861f9cf5e27b6f39ae8e14e5acc676657b92
