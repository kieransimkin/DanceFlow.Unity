# Byte-exact SHA-256 fixtures: never apply core.autocrlf or EOL conversion.
# Keep readable Git diffs, but preserve original blob bytes on every checkout.
.gitattributes text eol=lf
Tests/Fixtures/dancerudiments-four-axes-v1.json -text diff
Tests/Fixtures/dancerudiments-four-axes-v1.receipt.json -text diff
Samples~/RiggedCharacterDemos/Data/*.rig-motion.json -text diff

# Canonical cross-platform checkout policy. Text fixtures, including hashed
# JSON, use LF bytes in Git and in every checkout.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
